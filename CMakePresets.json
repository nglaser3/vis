{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CAEROR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "rel-omp",
      "inherits": "release",
      "cacheVariables": {
        "ENABLE_OPENMP": "ON",
        "ENABLE_CUDA": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "rel-omp",
      "configurePreset": "rel-omp"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true,
        "shortProgress": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "release",
      "steps": [
        {"type": "configure", "name": "release"},
        {"type": "build", "name": "release"}
      ]
    },
    {
      "name": "rel-omp",
      "steps": [
        {"type": "configure", "name": "rel-omp"},
        {"type": "build", "name": "rel-omp"}
      ]
    }
  ]
}
